---
import type { Course } from '../data/siteData';
import { SITE_DATA } from '../data/siteData';

interface Props {
  course: Course;
  index?: number;
}

const { course, index = 0 } = Astro.props;
const whatsappLink = SITE_DATA.getWhatsAppLink(course.title);
---

<article class={`course-card ${course.isFlagship ? 'flagship-card' : ''}`} data-course-id={course.id}>
  <div class="card-media-wrap">
    <img 
      src={course.heroImage} 
      alt={course.title} 
      class="card-img" 
      loading="lazy" 
      width="600" 
      height="400" 
    />
    <div class="card-media-overlay"></div>
    <div class="card-badge-row">
      <span class={`tag ${course.isFlagship ? 'tag-copper' : 'tag-gold'}`}>
        {course.isFlagship ? 'Flagship Diploma' : course.category}
      </span>
      <span class="tag duration-tag">
        {course.duration}
      </span>
    </div>
  </div>

  <div class="card-body">
    <div class="card-header-group">
      <h3 class="card-title">
        {course.isFlagship ? (
          <a href="/courses/dca">{course.title}</a>
        ) : (
          course.title
        )}
      </h3>
      <p class="card-subtitle">{course.subtitle}</p>
    </div>

    <p class="card-desc">{course.description}</p>

    <!-- Verified Highlights List -->
    <ul class="card-highlights">
      {course.verifiedHighlights.slice(0, 3).map((item) => (
        <li>
          <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>{item}</span>
        </li>
      ))}
    </ul>

    <!-- Card Metadata Strip -->
    <div class="card-meta-strip">
      <div class="meta-unit">
        <span class="meta-label">Batch Cap</span>
        <span class="meta-val">{course.seatsPerBatch} Students / Station</span>
      </div>
      <div class="meta-unit">
        <span class="meta-label">Class Shifts</span>
        <span class="meta-val">Morning & Afternoon</span>
      </div>
    </div>

    <!-- Actions -->
    <div class="card-actions">
      {course.isFlagship ? (
        <a href="/courses/dca" class="btn btn-primary btn-sm">
          Explore DCA &rarr;
        </a>
      ) : (
        <button 
          type="button" 
          class="btn btn-secondary btn-sm" 
          data-open-inquiry-modal 
          data-preselect-course={course.title}
        >
          Details
        </button>
      )}

      <a 
        href={whatsappLink} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn btn-whatsapp btn-sm"
        aria-label={`Inquire about ${course.title} on WhatsApp`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
        </svg>
        WhatsApp
      </a>
    </div>
  </div>
</article>

<style>
  .course-card {
    background: #0E141C;
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-sm);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-normal), border-color var(--transition-normal), box-shadow var(--transition-normal);
  }

  .course-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
  }

  /* Flagship Styling */
  .flagship-card {
    border-color: rgba(217, 119, 54, 0.35);
    background: linear-gradient(180deg, #121924 0%, #0E141C 100%);
    box-shadow: 0 10px 30px rgba(217, 119, 54, 0.1);
  }

  .flagship-card:hover {
    border-color: var(--color-copper);
    box-shadow: 0 20px 50px rgba(217, 119, 54, 0.25);
  }

  /* Media */
  .card-media-wrap {
    position: relative;
    width: 100%;
    height: 240px;
    overflow: hidden;
    background: #05080C;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .course-card:hover .card-img {
    transform: scale(1.05);
  }

  .card-media-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(9, 13, 18, 0.1) 0%, rgba(9, 13, 18, 0.8) 100%);
  }

  .card-badge-row {
    position: absolute;
    top: 1rem;
    left: 1rem;
    right: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    z-index: 2;
  }

  .duration-tag {
    background: rgba(9, 13, 18, 0.75);
    backdrop-filter: blur(4px);
  }

  /* Body */
  .card-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 1.25rem;
  }

  .card-header-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .card-title a:hover {
    color: var(--color-copper-light);
  }

  .card-subtitle {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.875rem;
    color: var(--color-copper-light);
    line-height: 1.35;
  }

  .card-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* Highlights */
  .card-highlights {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border-dark);
  }

  .card-highlights li {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    line-height: 1.45;
  }

  .check-icon {
    color: var(--color-copper);
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Meta Strip */
  .card-meta-strip {
    display: flex;
    justify-content: space-between;
    background: rgba(255, 255, 255, 0.03);
    border-radius: var(--radius-xs);
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--color-border-dark);
  }

  .meta-unit {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .meta-label {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .meta-val {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  /* Actions */
  .card-actions {
    display: flex;
    gap: 0.75rem;
  }

  .card-actions .btn {
    flex: 1;
  }
</style>
