---
import type { Course } from '../data/siteData';
import { SITE_DATA } from '../data/siteData';

interface Props {
  course: Course;
  index?: number;
}

const { course, index = 0 } = Astro.props;
const whatsappLink = SITE_DATA.getWhatsAppLink(course.title);
---

<article class="cib-course-card" data-course-id={course.id}>
  <!-- Course Image with Offset Architectural Framing -->
  <div class="card-media">
    <img 
      src={course.heroImage} 
      alt={course.title} 
      class="card-img" 
      loading="lazy" 
      width="600" 
      height="380" 
    />
    <div class="card-tag-badge">
      <span class="micro-label card-category-label">
        {course.isFlagship ? 'FLAGSHIP DIPLOMA' : course.category.toUpperCase()}
      </span>
      <span class="card-duration">{course.duration}</span>
    </div>
  </div>

  <div class="card-content">
    <div class="card-title-group">
      <h3 class="card-title">
        {course.isFlagship ? (
          <a href="/courses/dca" class="card-link">{course.title}</a>
        ) : (
          course.title
        )}
      </h3>
      <p class="card-subtitle">{course.subtitle}</p>
    </div>

    <p class="card-desc">{course.description}</p>

    <!-- Verified Highlights (Strict hairline separators) -->
    <ul class="card-highlights">
      {course.verifiedHighlights.slice(0, 3).map((item) => (
        <li class="highlight-item">
          <span class="accent-bullet"></span>
          <span>{item}</span>
        </li>
      ))}
    </ul>

    <!-- Footer Actions: Architectural Buttons -->
    <div class="card-footer">
      {course.isFlagship ? (
        <a href="/courses/dca" class="btn btn-cib-solid btn-sm">
          Explore DCA &rarr;
        </a>
      ) : (
        <button 
          type="button" 
          class="btn btn-cib-outline btn-sm" 
          data-open-inquiry-modal 
          data-preselect-course={course.title}
        >
          Syllabus & Info
        </button>
      )}

      <a 
        href={whatsappLink} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="card-wa-link"
        aria-label={`Inquire about ${course.title} on WhatsApp`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.976.58 2.029.924 3.149.925h.005c3.182 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.767-5.773-5.767zm0 10.375c-.981 0-1.898-.284-2.697-.79l-.193-.115-1.393.365.372-1.357-.126-.201c-.552-.881-.844-1.867-.843-2.88.001-2.535 2.062-4.597 4.6-4.597 2.536 0 4.601 2.061 4.601 4.597 0 2.537-2.064 4.598-4.598 4.598zm2.525-3.447c-.138-.07-.82-.405-.947-.451-.128-.046-.221-.07-.314.07-.093.139-.36.452-.441.545-.081.093-.163.105-.302.035-.139-.07-.588-.217-1.12-.692-.414-.37-.693-.827-.775-.966-.081-.139-.009-.215.061-.284.063-.062.139-.163.209-.244.07-.081.093-.139.139-.232.047-.093.023-.174-.012-.244-.035-.07-.314-.755-.43-1.034-.113-.271-.228-.234-.314-.239l-.268-.005c-.093 0-.244.035-.371.174-.128.139-.488.476-.488 1.16 0 .685.499 1.346.569 1.439.07.093.982 1.5 2.38 2.104.333.144.593.229.796.294.335.106.639.091.88.055.269-.04.82-.336.936-.661.116-.325.116-.603.081-.661-.035-.059-.128-.094-.267-.163z"/>
        </svg>
        <span>WhatsApp</span>
      </a>
    </div>
  </div>
</article>

<style>
  .cib-course-card {
    display: flex;
    flex-direction: column;
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    overflow: hidden;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal);
  }

  .cib-course-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: var(--color-border-medium);
  }

  .card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--color-bg-cream);
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cib-course-card:hover .card-img {
    transform: scale(1.04);
  }

  .card-tag-badge {
    position: absolute;
    bottom: 0.85rem;
    left: 0.85rem;
    right: 0.85rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-xs);
    border: 1px solid rgba(11, 19, 43, 0.08);
  }

  .card-category-label {
    font-size: 0.65rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .card-duration {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--color-navy);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-align: right;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    flex-grow: 1;
  }

  .card-title-group {
    margin-bottom: 0.75rem;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-navy);
  }

  .card-link {
    color: inherit;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .card-link:hover {
    color: var(--color-orange);
  }

  .card-subtitle {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin-top: 0.35rem;
    line-height: 1.4;
  }

  .card-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-body);
    margin-bottom: 1.25rem;
  }

  .card-highlights {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 1.5rem;
  }

  .highlight-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-text-secondary);
  }

  .accent-bullet {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-orange);
    flex-shrink: 0;
    margin-top: 0.45rem;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
  }

  .card-wa-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-navy);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    transition: color var(--transition-fast);
  }

  .card-wa-link:hover {
    color: var(--color-emerald);
  }
</style>
