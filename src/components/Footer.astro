---
import { SITE_DATA } from '../data/siteData';
---

<footer class="site-footer" id="contact">
  <div class="container-wide footer-content">
    <!-- Top Editorial Callout -->
    <div class="footer-hero-band">
      <div class="footer-hero-copy">
        <span class="eyebrow">Kathmandu Hospitality Hub</span>
        <h2 class="footer-title">Ready to Step into the Kitchen?</h2>
        <p class="footer-lead">
          Visit our Pipalbot, Old Baneshwor campus for a live kitchen tour, meet our chef instructors, and get answers on upcoming batch intakes.
        </p>
      </div>
      <div class="footer-hero-cta">
        <a 
          href={SITE_DATA.getWhatsAppLink(undefined, 'Campus Visit Booking')} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-whatsapp btn-lg"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.976.58 2.029.924 3.149.925h.005c3.182 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.767-5.773-5.767zm0 10.375c-.981 0-1.898-.284-2.697-.79l-.193-.115-1.393.365.372-1.357-.126-.201c-.552-.881-.844-1.867-.843-2.88.001-2.535 2.062-4.597 4.6-4.597 2.536 0 4.601 2.061 4.601 4.597 0 2.537-2.064 4.598-4.598 4.598zm2.525-3.447c-.138-.07-.82-.405-.947-.451-.128-.046-.221-.07-.314.07-.093.139-.36.452-.441.545-.081.093-.163.105-.302.035-.139-.07-.588-.217-1.12-.692-.414-.37-.693-.827-.775-.966-.081-.139-.009-.215.061-.284.063-.062.139-.163.209-.244.07-.081.093-.139.139-.232.047-.093.023-.174-.012-.244-.035-.07-.314-.755-.43-1.034-.113-.271-.228-.234-.314-.239l-.268-.005c-.093 0-.244.035-.371.174-.128.139-.488.476-.488 1.16 0 .685.499 1.346.569 1.439.07.093.982 1.5 2.38 2.104.333.144.593.229.796.294.335.106.639.091.88.055.269-.04 82-.336.936-.661.116-.325.116-.603.081-.661-.035-.059-.128-.094-.267-.163z"/>
          </svg>
          Schedule via WhatsApp
        </a>
        <button type="button" class="btn btn-secondary btn-lg" data-open-inquiry-modal>
          Online Inquiry Form
        </button>
      </div>
    </div>

    <!-- Main Footer Grid -->
    <div class="footer-grid">
      <!-- Col 1: Brand & Verified Information -->
      <div class="footer-col brand-col">
        <div class="brand-crest-large">
          <img src="/images/brand/logo.jpg" alt="Elite Logo" width="56" height="56" />
          <div>
            <h3 class="footer-brand-title">{SITE_DATA.institution.name}</h3>
            <p class="footer-slogan">"{SITE_DATA.institution.tagline}"</p>
          </div>
        </div>
        <p class="footer-desc">
          A hands-on hospitality training academy based in Old Baneshwor, Kathmandu, delivering commercial kitchen, bar, coffee, and guestroom practical mastery.
        </p>
        <div class="verified-metrics-pill">
          <span class="pill-star">★ 4.7</span>
          <span>Google Verified ({SITE_DATA.proofMetrics.googleReviewCount} Reviews)</span>
          <span>• 7.1K+ FB Community</span>
        </div>
      </div>

      <!-- Col 2: Programs -->
      <div class="footer-col">
        <h4 class="col-heading">Flagship & Programs</h4>
        <ul class="footer-links">
          <li><a href="/courses/dca" class="highlight-dca-link"><strong>Diploma in Culinary Arts (DCA)</strong></a></li>
          <li><a href="/#courses">Diploma in Hotel Management (DHM)</a></li>
          <li><a href="/#courses">Professional Barista Training</a></li>
          <li><a href="/#courses">Bakery & Pastry Arts</a></li>
          <li><a href="/#courses">Bartending & Flair Mixology</a></li>
          <li><a href="/#courses">Professional Sushi Masterclass</a></li>
          <li><a href="/#courses">Housekeeping & Front Office</a></li>
        </ul>
      </div>

      <!-- Col 3: Direct Contacts -->
      <div class="footer-col">
        <h4 class="col-heading">Campus & Contacts</h4>
        <div class="contact-details">
          <div class="contact-item">
            <span class="contact-label">Location:</span>
            <span class="contact-value">{SITE_DATA.institution.address}</span>
          </div>
          <div class="contact-item">
            <span class="contact-label">Direct Landline:</span>
            <span class="contact-value"><a href={`tel:${SITE_DATA.institution.primaryPhone}`}>{SITE_DATA.institution.primaryPhone}</a> / <a href={`tel:${SITE_DATA.institution.alternatePhone}`}>{SITE_DATA.institution.alternatePhone}</a></span>
          </div>
          <div class="contact-item">
            <span class="contact-label">Admissions Mobile:</span>
            <span class="contact-value"><a href={`tel:${SITE_DATA.institution.mobilePhone}`}>{SITE_DATA.institution.mobilePhone}</a> / <a href={`tel:${SITE_DATA.institution.secondaryMobile}`}>{SITE_DATA.institution.secondaryMobile}</a></span>
          </div>
          <div class="contact-item">
            <span class="contact-label">Email:</span>
            <span class="contact-value"><a href={`mailto:${SITE_DATA.institution.email}`}>{SITE_DATA.institution.email}</a></span>
          </div>
          <div class="contact-item">
            <span class="contact-label">Hours:</span>
            <span class="contact-value">{SITE_DATA.institution.hours}</span>
          </div>
        </div>
      </div>

      <!-- Col 4: Campus Map -->
      <div class="footer-col map-col">
        <h4 class="col-heading">Find Our Campus</h4>
        <div class="map-container">
          <iframe 
            src={SITE_DATA.institution.googleMapsEmbedUrl} 
            width="100%" 
            height="180" 
            style="border:0; filter: grayscale(80%) invert(90%) contrast(85%);" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            title="Elite School of Hospitality Location Map"
          ></iframe>
        </div>
        <a href={SITE_DATA.institution.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="map-link">
          Open in Google Maps ({SITE_DATA.institution.plusCode}) &rarr;
        </a>
      </div>
    </div>

    <!-- Bottom Legal / Demo Safety Band -->
    <div class="footer-bottom">
      <div class="bottom-left">
        <p>&copy; {new Date().getFullYear()} {SITE_DATA.institution.name}. All rights reserved.</p>
        <p class="demo-tag">Client Demo Presentation Build • Kathmandu, Nepal</p>
      </div>
      <div class="bottom-right">
        <a href="/courses/dca">DCA Course</a>
        <span>•</span>
        <a href="#courses">Programs</a>
        <span>•</span>
        <a href={SITE_DATA.getWhatsAppLink()} target="_blank" rel="noopener noreferrer">WhatsApp Direct</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #06090D;
    color: var(--color-text-primary);
    border-top: 1px solid var(--color-border-dark);
    padding-top: clamp(4rem, 7vw, 6rem);
    padding-bottom: 2.5rem;
    position: relative;
  }

  /* Top Hero Band */
  .footer-hero-band {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 4rem;
    border-bottom: 1px solid var(--color-border-dark);
    margin-bottom: 4rem;
  }

  @media (min-width: 992px) {
    .footer-hero-band {
      flex-direction: row;
      align-items: flex-end;
    }
  }

  .footer-hero-copy {
    max-width: 680px;
  }

  .footer-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .footer-lead {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .footer-hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    flex-shrink: 0;
  }

  /* Grid Columns */
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding-bottom: 4rem;
    border-bottom: 1px solid var(--color-border-dark);
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.3fr 0.9fr 1.1fr 1fr;
    }
  }

  .brand-crest-large {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .brand-crest-large img {
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .footer-brand-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .footer-slogan {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.875rem;
    color: var(--color-copper);
    margin-top: 2px;
  }

  .footer-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: 1.25rem;
  }

  .verified-metrics-pill {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.75rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .pill-star {
    color: var(--color-gold);
    font-weight: 700;
  }

  .col-heading {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin-bottom: 1.25rem;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-links a {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--color-text-primary);
  }

  .highlight-dca-link {
    color: var(--color-copper-light) !important;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    font-size: 0.875rem;
  }

  .contact-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .contact-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .contact-value {
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  .contact-value a:hover {
    color: var(--color-text-primary);
  }

  /* Map Container */
  .map-container {
    width: 100%;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--color-border-dark);
    margin-bottom: 0.75rem;
  }

  .map-link {
    font-size: 0.8125rem;
    color: var(--color-copper);
    font-weight: 600;
    display: inline-block;
  }

  .map-link:hover {
    text-decoration: underline;
  }

  /* Footer Bottom */
  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: space-between;
    align-items: flex-start;
    padding-top: 2rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      align-items: center;
    }
  }

  .demo-tag {
    font-size: 0.75rem;
    color: var(--color-copper);
    margin-top: 2px;
  }

  .bottom-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .bottom-right a:hover {
    color: var(--color-text-primary);
  }
</style>
