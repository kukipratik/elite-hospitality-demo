---
import { SITE_DATA } from '../data/siteData';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const whatsappLink = SITE_DATA.getWhatsAppLink();
---

<header class="site-header" id="mainHeader">
  <div class="header-inner container-wide">
    <!-- Brand Crest & Title -->
    <a href="/" class="brand-link" aria-label="Elite School of Hospitality Management Home">
      <div class="brand-crest">
        <img src="/images/brand/logo.jpg" alt="Elite Crest" width="44" height="44" />
      </div>
      <div class="brand-meta">
        <span class="brand-title">ELITE</span>
        <span class="brand-subtitle">School of Hospitality Management</span>
      </div>
    </a>

    <!-- Live Status Pill (Subtle & Professional) -->
    <div class="live-intake-badge">
      <span class="pulse-dot"></span>
      <span class="badge-label">2026 Admissions Open</span>
    </div>

    <!-- Desktop Nav Links -->
    <nav class="desktop-nav" aria-label="Primary Navigation">
      <a href="/#courses" class={`nav-link ${currentPath === '/#courses' ? 'active' : ''}`}>Programs</a>
      <a href="/courses/dca" class={`nav-link ${currentPath === '/courses/dca' ? 'active highlight-dca' : ''}`}>
        <span class="tag-flagship">Flagship</span>
        DCA Diploma
      </a>
      <a href="/#practical" class="nav-link">Kitchen Training</a>
      <a href="/#video-gallery" class="nav-link">Inside Elite</a>
      <a href="/#internship" class="nav-link">Internship & Placement</a>
      <a href="/#campus" class="nav-link">Campus Visit</a>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <!-- Direct WhatsApp Action -->
      <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-sm" aria-label="Chat with Admissions on WhatsApp">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.976.58 2.029.924 3.149.925h.005c3.182 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.767-5.773-5.767zm0 10.375c-.981 0-1.898-.284-2.697-.79l-.193-.115-1.393.365.372-1.357-.126-.201c-.552-.881-.844-1.867-.843-2.88.001-2.535 2.062-4.597 4.6-4.597 2.536 0 4.601 2.061 4.601 4.597 0 2.537-2.064 4.598-4.598 4.598zm2.525-3.447c-.138-.07-.82-.405-.947-.451-.128-.046-.221-.07-.314.07-.093.139-.36.452-.441.545-.081.093-.163.105-.302.035-.139-.07-.588-.217-1.12-.692-.414-.37-.693-.827-.775-.966-.081-.139-.009-.215.061-.284.063-.062.139-.163.209-.244.07-.081.093-.139.139-.232.047-.093.023-.174-.012-.244-.035-.07-.314-.755-.43-1.034-.113-.271-.228-.234-.314-.239l-.268-.005c-.093 0-.244.035-.371.174-.128.139-.488.476-.488 1.16 0 .685.499 1.346.569 1.439.07.093.982 1.5 2.38 2.104.333.144.593.229.796.294.335.106.639.091.88.055.269-.04 82-.336.936-.661.116-.325.116-.603.081-.661-.035-.059-.128-.094-.267-.163z"/>
        </svg>
        <span class="whatsapp-text">WhatsApp</span>
      </a>

      <!-- Modal trigger -->
      <button type="button" class="btn btn-secondary btn-sm" data-open-inquiry-modal aria-haspopup="dialog">
        <span>Inquire</span>
      </button>

      <!-- Mobile Hamburger -->
      <button type="button" class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle navigation menu" aria-expanded="false">
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div class="mobile-drawer" id="mobileDrawer">
    <nav class="mobile-nav" aria-label="Mobile Navigation">
      <a href="/#courses" class="mobile-nav-link">All Programs</a>
      <a href="/courses/dca" class="mobile-nav-link highlight-link">
        <span>Diploma in Culinary Arts (DCA)</span>
        <span class="mobile-flagship-tag">Flagship</span>
      </a>
      <a href="/#practical" class="mobile-nav-link">Kitchen Training (60+ Days)</a>
      <a href="/#video-gallery" class="mobile-nav-link">Inside Elite Reels</a>
      <a href="/#internship" class="mobile-nav-link">Internship & ODC</a>
      <a href="/#reviews" class="mobile-nav-link">Student Reviews</a>
      <a href="/#campus" class="mobile-nav-link">Location & Visit</a>
      
      <div class="mobile-drawer-actions">
        <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-lg w-full">
          Chat on WhatsApp
        </a>
        <button type="button" class="btn btn-secondary btn-lg w-full" data-open-inquiry-modal>
          Book Campus Visit / Inquire
        </button>
      </div>

      <div class="mobile-drawer-contact">
        <p><strong>Devkota Sadak, Pipalbot, Old Baneshwor</strong></p>
        <p>Call: {SITE_DATA.institution.primaryPhone} / {SITE_DATA.institution.mobilePhone}</p>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    background: rgba(9, 13, 18, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--color-border-dark);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 76px;
    gap: 1.5rem;
  }

  /* Brand Link */
  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-crest {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: #000;
  }

  .brand-crest img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .brand-meta {
    display: flex;
    flex-direction: column;
  }

  .brand-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--color-text-primary);
    line-height: 1;
  }

  .brand-subtitle {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    color: var(--color-copper);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-weight: 600;
    margin-top: 2px;
  }

  /* Intake status pill */
  .live-intake-badge {
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.75rem;
    background: rgba(217, 119, 54, 0.12);
    border: 1px solid rgba(217, 119, 54, 0.3);
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-copper-light);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  @media (min-width: 1200px) {
    .live-intake-badge {
      display: inline-flex;
    }
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    background-color: var(--color-copper);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--color-copper);
    animation: pulseGlow 2s infinite ease-in-out;
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  /* Desktop Navigation */
  .desktop-nav {
    display: none;
    align-items: center;
    gap: 1.75rem;
  }

  @media (min-width: 992px) {
    .desktop-nav {
      display: flex;
    }
  }

  .nav-link {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
    position: relative;
    padding: 0.25rem 0;
  }

  .nav-link:hover, .nav-link.active {
    color: var(--color-text-primary);
  }

  .highlight-dca {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-copper-light);
  }

  .tag-flagship {
    font-size: 0.625rem;
    padding: 0.1rem 0.4rem;
    background: var(--color-copper);
    color: #fff;
    border-radius: 2px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .whatsapp-text {
    display: inline-block;
  }

  @media (max-width: 480px) {
    .whatsapp-text {
      display: none;
    }
    .header-actions .btn-whatsapp {
      padding: 0.65rem 0.85rem;
    }
  }

  /* Mobile Toggle */
  .mobile-menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 8px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-sm);
  }

  @media (min-width: 992px) {
    .mobile-menu-toggle {
      display: none;
    }
  }

  .hamburger-bar {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--color-text-primary);
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  /* Mobile Drawer */
  .mobile-drawer {
    display: none;
    position: fixed;
    top: 76px;
    left: 0;
    width: 100%;
    height: calc(100vh - 76px);
    background: rgba(9, 13, 18, 0.98);
    backdrop-filter: blur(20px);
    border-top: 1px solid var(--color-border-dark);
    padding: 2rem var(--gutter);
    overflow-y: auto;
  }

  .mobile-drawer.is-open {
    display: block;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .mobile-nav-link {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-text-primary);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border-dark);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mobile-nav-link.highlight-link {
    color: var(--color-copper);
  }

  .mobile-flagship-tag {
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    background: var(--color-copper);
    color: #fff;
    border-radius: 2px;
  }

  .mobile-drawer-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .w-full {
    width: 100%;
  }

  .mobile-drawer-contact {
    margin-top: 2rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }
</style>

<script>
  // Mobile navigation drawer toggle
  const toggleBtn = document.getElementById('mobileMenuToggle');
  const drawer = document.getElementById('mobileDrawer');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = drawer.classList.toggle('is-open');
      toggleBtn.setAttribute('aria-expanded', String(isOpen));
    });

    // Close when clicking a link inside mobile drawer
    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        drawer.classList.remove('is-open');
        toggleBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
