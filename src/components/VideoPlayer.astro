---
interface Props {
  videoSrc: string;
  posterSrc: string;
  title: string;
  tag: string;
  durationText?: string;
  id: string;
}

const { videoSrc, posterSrc, title, tag, durationText = '0:15', id } = Astro.props;
---

<div class="video-card-wrap" data-video-card id={`card-${id}`}>
  <div class="video-container">
    <video 
      id={id}
      class="reel-video"
      src={videoSrc}
      poster={posterSrc}
      playsinline
      muted
      loop
      preload="metadata"
    ></video>
    
    <!-- Video Overlay Gradient -->
    <div class="video-overlay"></div>

    <!-- Play/Pause Button Overlay -->
    <button type="button" class="video-play-btn" data-video-toggle={id} aria-label={`Play or pause video: ${title}`}>
      <svg class="icon-play" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
        <polygon points="5 3 19 12 5 21 5 3"></polygon>
      </svg>
      <svg class="icon-pause" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
        <rect x="6" y="4" width="4" height="16"></rect>
        <rect x="14" y="4" width="4" height="16"></rect>
      </svg>
    </button>

    <!-- Mute/Unmute Toggle -->
    <button type="button" class="video-mute-btn" data-video-mute={id} aria-label="Toggle mute state">
      <svg class="icon-muted" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
        <line x1="23" y1="9" x2="17" y2="15"></line>
        <line x1="17" y1="9" x2="23" y2="15"></line>
      </svg>
      <svg class="icon-unmuted" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
        <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
      </svg>
    </button>

    <!-- Video Badges -->
    <div class="video-meta-top">
      <span class="tag tag-copper">{tag}</span>
      <span class="tag duration-tag">{durationText}</span>
    </div>

    <!-- Video Caption & Meta Bottom -->
    <div class="video-meta-bottom">
      <h4 class="video-title">{title}</h4>
      <p class="video-source">Authentic Session • Elite School of Hospitality</p>
    </div>
  </div>
</div>

<style>
  .video-card-wrap {
    position: relative;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: #0B0F14;
    border: 1px solid var(--color-border-dark);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6);
    transition: transform var(--transition-normal), border-color var(--transition-normal);
  }

  .video-card-wrap:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .video-container {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    max-height: 520px;
    background: #05080C;
    overflow: hidden;
  }

  .reel-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(9, 13, 18, 0.3) 0%, transparent 40%, rgba(9, 13, 18, 0.9) 100%);
    pointer-events: none;
  }

  /* Play/Pause Button */
  .video-play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(9, 13, 18, 0.75);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
    z-index: 5;
  }

  .video-play-btn:hover {
    background: var(--color-copper);
    transform: translate(-50%, -50%) scale(1.1);
  }

  .icon-pause {
    display: none;
  }

  .is-playing .icon-play {
    display: none;
  }

  .is-playing .icon-pause {
    display: block;
  }

  .is-playing .video-play-btn {
    opacity: 0;
  }

  .video-card-wrap:hover .is-playing .video-play-btn {
    opacity: 0.8;
  }

  /* Mute Toggle */
  .video-mute-btn {
    position: absolute;
    bottom: 4.5rem;
    right: 1rem;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    border: 1px solid var(--color-border-dark);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
    transition: background var(--transition-fast);
  }

  .video-mute-btn:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .icon-unmuted {
    display: none;
  }

  .is-unmuted .icon-muted {
    display: none;
  }

  .is-unmuted .icon-unmuted {
    display: block;
  }

  /* Meta Placement */
  .video-meta-top {
    position: absolute;
    top: 1rem;
    left: 1rem;
    right: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 4;
  }

  .duration-tag {
    background: rgba(0, 0, 0, 0.65);
  }

  .video-meta-bottom {
    position: absolute;
    bottom: 1.25rem;
    left: 1.25rem;
    right: 1.25rem;
    z-index: 4;
  }

  .video-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.25;
    margin-bottom: 0.25rem;
  }

  .video-source {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }
</style>

<script>
  // Video playback controller
  const playButtons = document.querySelectorAll('[data-video-toggle]');
  const muteButtons = document.querySelectorAll('[data-video-mute]');

  playButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const videoId = btn.getAttribute('data-video-toggle');
      if (!videoId) return;
      const video = document.getElementById(videoId) as HTMLVideoElement | null;
      const card = btn.closest('[data-video-card]');

      if (video && card) {
        if (video.paused) {
          // Pause all other videos first for performance
          document.querySelectorAll('video').forEach((v) => {
            if (v !== video) {
              v.pause();
              v.closest('[data-video-card]')?.classList.remove('is-playing');
            }
          });
          video.play();
          card.classList.add('is-playing');
        } else {
          video.pause();
          card.classList.remove('is-playing');
        }
      }
    });
  });

  muteButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const videoId = btn.getAttribute('data-video-mute');
      if (!videoId) return;
      const video = document.getElementById(videoId) as HTMLVideoElement | null;
      const card = btn.closest('[data-video-card]');

      if (video && card) {
        video.muted = !video.muted;
        if (video.muted) {
          card.classList.remove('is-unmuted');
        } else {
          card.classList.add('is-unmuted');
        }
      }
    });
  });
</script>
