---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_DATA } from '../../data/siteData';

const dcaCourse = SITE_DATA.courses.find(c => c.id === 'dca') || SITE_DATA.courses[0];
const whatsappLink = SITE_DATA.getWhatsAppLink(dcaCourse.title);
---

<BaseLayout 
  title="Diploma in Culinary Arts (DCA) | Elite School of Hospitality Management"
  description="Kathmandu's premier 6-month professional chef qualification at Pipalbot, Old Baneshwor. 60+ days nonstop kitchen practicals, ten 4-course menus, artisan bakery, sushi, and structured hotel internships in Nepal."
  currentPath="/courses/dca"
  courseTitleForWa="Diploma in Culinary Arts (DCA)"
>
  <!-- 1. BREADCRUMBS -->
  <nav class="breadcrumb-bar" aria-label="Breadcrumb navigation">
    <div class="container-wide">
      <ol class="breadcrumbs">
        <li><a href="/">Home</a></li>
        <li class="separator">/</li>
        <li><a href="/#courses">Programs</a></li>
        <li class="separator">/</li>
        <li aria-current="page" class="active">Diploma in Culinary Arts (DCA)</li>
      </ol>
    </div>
  </nav>

  <!-- 2. COURSE HERO -->
  <section class="course-hero-section">
    <div class="container-wide course-hero-grid">
      <div class="hero-copy-col">
        <div class="eyebrow">
          <span>Flagship Professional Qualification</span>
        </div>

        <h1 class="course-headline">
          DIPLOMA IN <br />
          <span class="text-orange">CULINARY ARTS</span> (DCA)
        </h1>

        <p class="course-serif-lead">
          The definitive professional chef program in Kathmandu. Built around <strong>60+ days of nonstop commercial kitchen practicals</strong>, the execution of <strong>Ten complete 4-course menus</strong>, artisan bakery, sushi mastery, and structured <strong>3 to 6 months hotel internships in Nepal</strong>.
        </p>

        <!-- Actions -->
        <div class="hero-actions">
          <a 
            href={whatsappLink} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn btn-cib-solid"
          >
            Inquire via WhatsApp &rarr;
          </a>
          <button type="button" class="btn btn-cib-outline" data-open-inquiry-modal data-preselect-course="Diploma in Culinary Arts (DCA)">
            Schedule Kitchen Visit
          </button>
        </div>

        <div class="hero-quick-meta">
          <span class="meta-item"><strong>Location:</strong> Pipalbot, Old Baneshwor</span>
          <span class="meta-item"><strong>Cap:</strong> 16 Students / Station</span>
          <span class="meta-item"><strong>Status:</strong> 2026 Admissions Open</span>
        </div>
      </div>

      <!-- Right Visual -->
      <div class="hero-visual-col">
        <div class="hero-img-frame">
          <img 
            src="/images/kitchen/searing_chicken.jpg" 
            alt="Live Hot Kitchen Searing at Elite School of Hospitality" 
            class="hero-main-img"
            width="680" 
            height="480"
            fetchpriority="high"
          />
          <div class="hero-accent-border"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. UNBOXED SPECS STRIP -->
  <section class="specs-bar-section">
    <div class="container-wide">
      <div class="unboxed-specs-grid">
        <div class="spec-unit">
          <span class="spec-label">PROGRAM DURATION</span>
          <div class="spec-val">6 Months</div>
          <span class="spec-sub">Full-Time Intensive</span>
        </div>

        <div class="spec-unit">
          <span class="spec-label">KITCHEN PRACTICAL</span>
          <div class="spec-val text-orange">60+ Days</div>
          <span class="spec-sub">Daily Station Cooking</span>
        </div>

        <div class="spec-unit">
          <span class="spec-label">BANQUET MENUS</span>
          <div class="spec-val">10 Menus</div>
          <span class="spec-sub">Complete 4-Course Services</span>
        </div>

        <div class="spec-unit">
          <span class="spec-label">HOTEL INTERNSHIP</span>
          <div class="spec-val">3–6 Months</div>
          <span class="spec-sub">Hotels & Resorts in Nepal</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. CURRICULUM MODULES DEEP DIVE -->
  <section class="section section-warm" id="curriculum">
    <div class="container-wide">
      <div class="section-header-editorial">
        <div>
          <span class="eyebrow">Comprehensive Syllabus</span>
          <h2 class="headline-xl">THE DCA <span class="text-orange">CURRICULUM.</span></h2>
        </div>
        <p class="lead-text">
          A rigorous 6-module curriculum engineered to transition students from kitchen fundamentals to commercial speed, plating artistry, and banquet readiness.
        </p>
      </div>

      <div class="modules-editorial-grid">
        {dcaCourse.modules.map((mod, index) => (
          <div class="module-editorial-card">
            <div class="module-header-line">
              <span class="module-index">MODULE {String(index + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="module-title">{mod.title}</h3>
            <p class="module-desc">{mod.description}</p>
            
            <div class="module-topics-block">
              <span class="topics-label">CORE COMPETENCIES:</span>
              <ul class="topics-list">
                {mod.topics.map(topic => (
                  <li>
                    <span class="topic-bullet"></span>
                    <span>{topic}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. SIGNATURE REQUIREMENT: TEN 4-COURSE MENUS -->
  <section class="section section-white" id="menus">
    <div class="container-wide">
      <div class="menus-feature-spread">
        <div class="menus-copy">
          <span class="eyebrow">Signature Requirement</span>
          <h2 class="headline-lg">
            TEN COMPLETE <br />
            <span class="text-orange">4-COURSE MENUS.</span>
          </h2>
          <p class="menus-lead serif-quote">
            “Cooking a single dish is hobby cookery. Cooking and coordinating ten full 4-course banquet services under commercial time constraints is what separates an amateur from an executive chef.”
          </p>
          <p class="menus-body">
            Every DCA candidate at Elite must execute ten complete 4-course menus: an appetizer or dressed salad, a classical clear or puree soup, an authentic pasta or starch course, and a showcased protein entrée with emulsified reduction sauces.
          </p>

          <div class="menus-course-breakdown">
            <div class="course-stage">
              <span class="stage-num">Course 1</span>
              <strong>Appetizers & Salads</strong>
              <p>Carpaccios, vinaigrettes, cured preparations, and plate balance.</p>
            </div>
            <div class="course-stage">
              <span class="stage-num">Course 2</span>
              <strong>Classical Soups</strong>
              <p>Consommé clarifications, bisques, veloutés, and garnitures.</p>
            </div>
            <div class="course-stage">
              <span class="stage-num">Course 3</span>
              <strong>Pasta & Starch</strong>
              <p>Handmade pasta, risotto precision, gnocchi, and sauce glazing.</p>
            </div>
            <div class="course-stage">
              <span class="stage-num">Course 4</span>
              <strong>Showcase Entrées</strong>
              <p>Searing poultry, meats, fish, vegetable turns, and pan sauces.</p>
            </div>
          </div>
        </div>

        <div class="menus-media">
          <img 
            src="/images/kitchen/chef_technique.jpg" 
            alt="Chef instructor technique demonstration at Elite School of Hospitality" 
            class="menus-img"
            width="650" 
            height="700"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 6. REAL-WORLD INTERNSHIP & CAREER ROADMAP -->
  <section class="section section-warm" id="placement">
    <div class="container-wide">
      <div class="section-header-editorial">
        <div>
          <span class="eyebrow">Industry Experience</span>
          <h2 class="headline-xl">STRUCTURED <span class="text-orange">INTERNSHIP.</span></h2>
        </div>
        <p class="lead-text">
          Upon completing kitchen practicals and menu examinations at our Pipalbot campus, students are placed into structured 3 to 6 months internships in Nepal's hotels, resorts, and fine dining restaurants.
        </p>
      </div>

      <div class="placement-steps-grid">
        <div class="placement-step">
          <div class="step-num">STAGE 01</div>
          <h3 class="step-title">Campus Practical Mastery</h3>
          <p class="step-desc">60+ days nonstop hot kitchen, bakery, sushi, and ten 4-course menu culinary masterclasses at Pipalbot, Old Baneshwor.</p>
        </div>

        <div class="placement-step">
          <div class="step-num">STAGE 02</div>
          <h3 class="step-title">ODC Banqueting Certification</h3>
          <p class="step-desc">Participation in outdoor catering (ODC) for luxury banquets and high-volume catering events, earning certified credentials.</p>
        </div>

        <div class="placement-step">
          <div class="step-num">STAGE 03</div>
          <h3 class="step-title">3 to 6 Months Hotel Placement</h3>
          <p class="step-desc">Structured industrial training across recognized hotels, resorts, and fine dining establishments in Nepal.</p>
        </div>

        <div class="placement-step">
          <div class="step-num">STAGE 04</div>
          <h3 class="step-title">Career Pathway & Beyond</h3>
          <p class="step-desc">Graduates build proven culinary resumes, paving the way for domestic executive roles and international hospitality transitions.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. ADMISSIONS & BATCH SCHEDULE CTA -->
  <section class="section section-white" id="admissions">
    <div class="container">
      <div class="admissions-box">
        <span class="eyebrow">Next Intake Enrollment</span>
        <h2 class="headline-lg">RESERVE YOUR KITCHEN STATION</h2>
        <p class="admissions-lead">
          To ensure every student receives direct access to commercial burners and knife coaching, DCA batches are capped at 16 students. Inquire now for current tuition fees, shift timings, and upcoming intake dates.
        </p>

        <div class="admissions-actions">
          <a 
            href={whatsappLink} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn btn-cib-solid btn-lg"
          >
            Chat with Admissions on WhatsApp
          </a>
          <button type="button" class="btn btn-cib-outline btn-lg" data-open-inquiry-modal data-preselect-course="Diploma in Culinary Arts (DCA)">
            Request Full Syllabus & Fees
          </button>
        </div>

        <div class="admissions-direct-call">
          <span>Direct Admissions Desk: </span>
          <a href={`tel:${SITE_DATA.institution.primaryPhone}`}>{SITE_DATA.institution.primaryPhone}</a> · 
          <a href={`tel:${SITE_DATA.institution.mobilePhone}`}>{SITE_DATA.institution.mobilePhone}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* =========================================================================
     1. BREADCRUMBS
     ========================================================================= */
  .breadcrumb-bar {
    background-color: var(--color-bg-warm);
    border-bottom: 1px solid var(--color-border);
    padding: 0.85rem 0;
  }

  .breadcrumbs {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .breadcrumbs a {
    color: var(--color-navy);
    transition: color var(--transition-fast);
  }

  .breadcrumbs a:hover {
    color: var(--color-orange);
  }

  .breadcrumbs .separator {
    color: var(--color-border-medium);
  }

  .breadcrumbs .active {
    color: var(--color-orange);
    font-weight: 700;
  }

  /* =========================================================================
     2. COURSE HERO
     ========================================================================= */
  .course-hero-section {
    position: relative;
    padding-top: clamp(3.5rem, 6vw, 6rem);
    padding-bottom: clamp(4rem, 7vw, 6.5rem);
    background-color: #FFFFFF;
    border-bottom: 1px solid var(--color-border);
  }

  .course-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(3rem, 5vw, 5rem);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .course-hero-grid {
      grid-template-columns: 1.15fr 0.95fr;
    }
  }

  .course-headline {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
    color: var(--color-navy);
    margin-bottom: 1.5rem;
  }

  .text-orange {
    color: var(--color-orange);
  }

  .course-serif-lead {
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 1.8vw, 1.45rem);
    line-height: 1.42;
    color: var(--color-navy);
    margin-bottom: 2.25rem;
    max-width: 58ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .hero-quick-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .hero-quick-meta strong {
    color: var(--color-navy);
  }

  .hero-img-frame {
    position: relative;
    width: 92%;
    border-radius: var(--radius-xs);
    overflow: hidden;
    box-shadow: var(--shadow-hover);
  }

  .hero-main-img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 11;
    object-fit: cover;
  }

  .hero-accent-border {
    position: absolute;
    inset: 1rem -1rem -1rem 1rem;
    border: 1.5px solid var(--color-orange);
    z-index: -1;
    pointer-events: none;
  }

  /* =========================================================================
     3. SPECS STRIP
     ========================================================================= */
  .specs-bar-section {
    background-color: var(--color-bg-warm);
    border-bottom: 1px solid var(--color-border);
    padding: 2.5rem 0;
  }

  .unboxed-specs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .unboxed-specs-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .unboxed-specs-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .spec-unit {
    display: flex;
    flex-direction: column;
  }

  .spec-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-orange);
    margin-bottom: 0.25rem;
  }

  .spec-val {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-navy);
    margin-bottom: 0.25rem;
  }

  .spec-sub {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  /* =========================================================================
     4. CURRICULUM MODULES
     ========================================================================= */
  .section-header-editorial {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }

  @media (min-width: 992px) {
    .section-header-editorial {
      flex-direction: row;
      align-items: flex-end;
    }
  }

  .modules-editorial-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .modules-editorial-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .modules-editorial-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .module-editorial-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .module-editorial-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  .module-header-line {
    margin-bottom: 0.75rem;
  }

  .module-index {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-orange);
  }

  .module-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.25;
    color: var(--color-navy);
    margin-bottom: 0.75rem;
  }

  .module-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
  }

  .module-topics-block {
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .topics-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-navy);
    margin-bottom: 0.65rem;
  }

  .topics-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .topics-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-text-body);
  }

  .topic-bullet {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: var(--color-orange);
    flex-shrink: 0;
  }

  /* =========================================================================
     5. TEN 4-COURSE MENUS FEATURE SPREAD
     ========================================================================= */
  .menus-feature-spread {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(3rem, 5vw, 5rem);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .menus-feature-spread {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }

  .menus-lead {
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    line-height: 1.4;
    color: var(--color-navy);
    margin-top: 1rem;
    margin-bottom: 1.5rem;
  }

  .menus-body {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin-bottom: 2.5rem;
  }

  .menus-course-breakdown {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 640px) {
    .menus-course-breakdown {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .course-stage {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stage-num {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-orange);
    letter-spacing: 0.1em;
  }

  .course-stage strong {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--color-navy);
  }

  .course-stage p {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .menus-img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-xs);
    box-shadow: var(--shadow-hover);
    object-fit: cover;
  }

  /* =========================================================================
     6. PLACEMENT ROADMAP
     ========================================================================= */
  .placement-steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .placement-steps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .placement-steps-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .placement-step {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    padding: 2rem;
    display: flex;
    flex-direction: column;
  }

  .step-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-orange);
    margin-bottom: 0.75rem;
  }

  .step-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.25;
    color: var(--color-navy);
    margin-bottom: 0.75rem;
  }

  .step-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* =========================================================================
     7. ADMISSIONS CTA BOX
     ========================================================================= */
  .admissions-box {
    text-align: center;
    max-width: 820px;
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 5rem) 1rem;
  }

  .admissions-lead {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin-top: 1rem;
    margin-bottom: 2.5rem;
  }

  .admissions-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .admissions-direct-call {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .admissions-direct-call a {
    color: var(--color-navy);
    font-weight: 700;
  }

  .admissions-direct-call a:hover {
    color: var(--color-orange);
  }
</style>
