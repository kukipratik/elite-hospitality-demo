---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_DATA } from '../../data/siteData';

const dcaCourse = SITE_DATA.courses.find(c => c.id === 'dca') || SITE_DATA.courses[0];
const whatsappLink = SITE_DATA.getWhatsAppLink(dcaCourse.title);
---

<BaseLayout 
  title="Diploma in Culinary Arts (DCA) | Elite School of Hospitality Management"
  description="Kathmandu's premier 6-month professional chef qualification at Pipalbot, Old Baneshwor. 60+ days nonstop kitchen practicals, ten 4-course menus, artisan bakery, sushi, and structured hotel internships in Nepal."
  currentPath="/courses/dca"
  courseTitleForWa="Diploma in Culinary Arts (DCA)"
>
  <!-- 1. BREADCRUMBS -->
  <nav class="breadcrumb-bar" aria-label="Breadcrumb navigation">
    <div class="container-wide">
      <ol class="breadcrumbs">
        <li><a href="/">Home</a></li>
        <li class="separator">/</li>
        <li><a href="/#courses">Programs</a></li>
        <li class="separator">/</li>
        <li aria-current="page" class="active">Diploma in Culinary Arts (DCA)</li>
      </ol>
    </div>
  </nav>

  <!-- 2. DCA ACADEMIC MASTHEAD -->
  <section class="dca-masthead-section">
    <div class="container-wide">
      <div class="dca-masthead-grid">
        <!-- Left Editorial Academic Column -->
        <div class="dca-editorial-col">
          <div class="dca-taxo-row">
            <span class="dca-code-badge">PROGRAM CODE // ESHM-DCA</span>
            <span class="dca-type-badge">6-MONTH VOCATIONAL DIPLOMA</span>
            <span class="dca-status-badge">
              <span class="pulse-dot"></span> ADMISSIONS 2026 OPEN
            </span>
          </div>

          <h1 class="dca-masthead-title">
            DIPLOMA IN<br />
            <span class="text-orange">CULINARY ARTS</span>
          </h1>

          <p class="dca-masthead-lead">
            Kathmandu’s premier hands-on culinary qualification engineered for aspiring commercial line chefs and future hospitality leaders. Built around <strong>60+ days of nonstop commercial kitchen practicals</strong>, the execution of <strong>Ten complete 4-course banquet services</strong>, artisan bakery, sushi mastery, and structured <strong>hotel & resort internships in Nepal</strong>.
          </p>

          <!-- Action Cluster: Primary WhatsApp + In-person Campus Visit Link -->
          <div class="dca-action-strip">
            <a 
              href={whatsappLink} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-cib-solid dca-primary-btn"
            >
              <span>Inquire via WhatsApp</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>

            <button 
              type="button" 
              class="dca-visit-trigger" 
              data-open-inquiry-modal 
              data-preselect-course="Diploma in Culinary Arts (DCA)"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <span>Book Kitchen Lab Tour</span>
              <span class="arrow">&rarr;</span>
            </button>
          </div>

          <!-- Fast Institutional Key Metrics (Integrated, Clean, Unboxed Grid) -->
          <div class="dca-metrics-row">
            <div class="dca-metric-cell">
              <span class="dca-metric-label">PRACTICAL TRAINING</span>
              <div class="dca-metric-val">60+ <span class="dca-metric-unit">Days</span></div>
              <span class="dca-metric-sub">Nonstop Kitchen Shifts</span>
            </div>

            <div class="dca-metric-cell">
              <span class="dca-metric-label">BANQUET EXAMS</span>
              <div class="dca-metric-val">10 <span class="dca-metric-unit">Menus</span></div>
              <span class="dca-metric-sub">4-Course Executions</span>
            </div>

            <div class="dca-metric-cell">
              <span class="dca-metric-label">HOTEL INTERNSHIP</span>
              <div class="dca-metric-val">3–6 <span class="dca-metric-unit">Mos</span></div>
              <span class="dca-metric-sub">Nepal Luxury Hotels</span>
            </div>

            <div class="dca-metric-cell">
              <span class="dca-metric-label">STATION COHORT</span>
              <div class="dca-metric-val">16 <span class="dca-metric-unit">Max</span></div>
              <span class="dca-metric-sub">Chefs Per Shift</span>
            </div>
          </div>
        </div>

        <!-- Right Media + Architectural Specification Dossier Column -->
        <div class="dca-visual-col">
          <div class="dca-media-cluster">
            <div class="dca-photo-wrapper">
              <img 
                src="/images/kitchen/searing_chicken.jpg" 
                alt="Live Hot Kitchen Searing at Elite School of Hospitality" 
                class="dca-masthead-img"
                width="640" 
                height="440"
                fetchpriority="high"
              />
              <div class="dca-photo-caption">
                <span class="caption-tag">LIVE KITCHEN LAB</span>
                <span class="caption-text">Hot station pan-searing & saucing practical at Pipalbot campus</span>
              </div>
            </div>

            <!-- Architectural Institutional Course Specification Dossier -->
            <div class="dca-spec-dossier">
              <div class="dossier-header">
                <div class="dossier-code-wrap">
                  <span class="dossier-code">COURSE SPECIFICATION // DCA-2026</span>
                  <span class="dossier-title">Academic & Practicum Dossier</span>
                </div>
                <div class="dossier-status-pill">
                  <span class="status-dot"></span> 2026 INTAKE
                </div>
              </div>

              <div class="dossier-table">
                <div class="dossier-row">
                  <span class="dossier-dt">Program Duration</span>
                  <span class="dossier-dd">6 Months (Full-Time Daily Practical)</span>
                </div>
                <div class="dossier-row">
                  <span class="dossier-dt">Practical Ratio</span>
                  <span class="dossier-dd highlight">80% Commercial Kitchen / 20% Theory</span>
                </div>
                <div class="dossier-row">
                  <span class="dossier-dt">Specialist Modules</span>
                  <span class="dossier-dd">Artisan Bakery, Knife Speed, Sushi Rolling</span>
                </div>
                <div class="dossier-row">
                  <span class="dossier-dt">Campus Facility</span>
                  <span class="dossier-dd">Pipalbot, Old Baneshwor, Kathmandu</span>
                </div>
                <div class="dossier-row">
                  <span class="dossier-dt">Industry Credentials</span>
                  <span class="dossier-dd">ESHM DCA Diploma + ODC Banqueting Cert</span>
                </div>
                <div class="dossier-row">
                  <span class="dossier-dt">Admissions Desk</span>
                  <span class="dossier-dd contact-links">
                    <a href="tel:014471162">01-4471162</a> &bull; <a href="tel:9851239109">9851239109</a>
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. STICKY SYLLABUS SUBNAV BAR -->
  <nav class="dca-subnav-bar" id="dca-subnav" aria-label="Course Sections">
    <div class="container-wide">
      <div class="dca-subnav-inner">
        <ul class="dca-subnav-links">
          <li>
            <a href="#curriculum" class="subnav-link active">
              <span class="subnav-idx">01</span>
              <span class="subnav-text">Curriculum Modules</span>
            </a>
          </li>
          <li>
            <a href="#menus" class="subnav-link">
              <span class="subnav-idx">02</span>
              <span class="subnav-text">Ten 4-Course Menus</span>
            </a>
          </li>
          <li>
            <a href="#placement" class="subnav-link">
              <span class="subnav-idx">03</span>
              <span class="subnav-text">Hotel Placement & ODC</span>
            </a>
          </li>
          <li>
            <a href="#admissions" class="subnav-link">
              <span class="subnav-idx">04</span>
              <span class="subnav-text">Admissions & Batches</span>
            </a>
          </li>
        </ul>

        <div class="dca-subnav-action">
          <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="dca-subnav-cta">
            <span>Inquire for DCA</span>
            <span class="cta-arrow">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </nav>

  <!-- 4. CURRICULUM MODULES DEEP DIVE -->
  <section class="section section-warm" id="curriculum">
    <div class="container-wide">
      <div class="section-header-editorial">
        <div>
          <span class="eyebrow">Comprehensive Syllabus</span>
          <h2 class="headline-xl">THE DCA <span class="text-orange">CURRICULUM.</span></h2>
        </div>
        <p class="lead-text">
          A rigorous 6-module curriculum engineered to transition students from kitchen fundamentals to commercial speed, plating artistry, and banquet readiness.
        </p>
      </div>

      <div class="modules-editorial-grid">
        {dcaCourse.modules.map((mod, index) => (
          <div class="module-editorial-card">
            <div class="module-header-line">
              <span class="module-index">MODULE {String(index + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="module-title">{mod.title}</h3>
            <p class="module-desc">{mod.description}</p>
            
            <div class="module-topics-block">
              <span class="topics-label">CORE COMPETENCIES:</span>
              <ul class="topics-list">
                {mod.topics.map(topic => (
                  <li>
                    <span class="topic-bullet"></span>
                    <span>{topic}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. SIGNATURE REQUIREMENT: TEN 4-COURSE MENUS -->
  <section class="section section-white" id="menus">
    <div class="container-wide">
      <div class="menus-feature-spread">
        <div class="menus-copy">
          <span class="eyebrow">Signature Requirement</span>
          <h2 class="headline-lg">
            TEN COMPLETE <br />
            <span class="text-orange">4-COURSE MENUS.</span>
          </h2>
          <p class="menus-lead serif-quote">
            “Cooking a single dish is hobby cookery. Cooking and coordinating ten full 4-course banquet services under commercial time constraints is what separates an amateur from an executive chef.”
          </p>
          <p class="menus-body">
            Every DCA candidate at Elite must execute ten complete 4-course menus: an appetizer or dressed salad, a classical clear or puree soup, an authentic pasta or starch course, and a showcased protein entrée with emulsified reduction sauces.
          </p>

          <div class="menus-course-breakdown">
            <div class="course-stage">
              <span class="stage-num">Course 1</span>
              <strong>Appetizers & Salads</strong>
              <p>Carpaccios, vinaigrettes, cured preparations, and plate balance.</p>
            </div>
            <div class="course-stage">
              <span class="stage-num">Course 2</span>
              <strong>Classical Soups</strong>
              <p>Consommé clarifications, bisques, veloutés, and garnitures.</p>
            </div>
            <div class="course-stage">
              <span class="stage-num">Course 3</span>
              <strong>Pasta & Starch</strong>
              <p>Handmade pasta, risotto precision, gnocchi, and sauce glazing.</p>
            </div>
            <div class="course-stage">
              <span class="stage-num">Course 4</span>
              <strong>Showcase Entrées</strong>
              <p>Searing poultry, meats, fish, vegetable turns, and pan sauces.</p>
            </div>
          </div>
        </div>

        <div class="menus-media">
          <img 
            src="/images/kitchen/chef_technique.jpg" 
            alt="Chef instructor technique demonstration at Elite School of Hospitality" 
            class="menus-img"
            width="650" 
            height="700"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 6. REAL-WORLD INTERNSHIP & CAREER ROADMAP -->
  <section class="section section-warm" id="placement">
    <div class="container-wide">
      <div class="section-header-editorial">
        <div>
          <span class="eyebrow">Industry Experience</span>
          <h2 class="headline-xl">STRUCTURED <span class="text-orange">INTERNSHIP.</span></h2>
        </div>
        <p class="lead-text">
          Upon completing kitchen practicals and menu examinations at our Pipalbot campus, students are placed into structured 3 to 6 months internships in Nepal's hotels, resorts, and fine dining restaurants.
        </p>
      </div>

      <div class="placement-steps-grid">
        <div class="placement-step">
          <div class="step-num">STAGE 01</div>
          <h3 class="step-title">Campus Practical Mastery</h3>
          <p class="step-desc">60+ days nonstop hot kitchen, bakery, sushi, and ten 4-course menu culinary masterclasses at Pipalbot, Old Baneshwor.</p>
        </div>

        <div class="placement-step">
          <div class="step-num">STAGE 02</div>
          <h3 class="step-title">ODC Banqueting Certification</h3>
          <p class="step-desc">Participation in outdoor catering (ODC) for luxury banquets and high-volume catering events, earning certified credentials.</p>
        </div>

        <div class="placement-step">
          <div class="step-num">STAGE 03</div>
          <h3 class="step-title">3 to 6 Months Hotel Placement</h3>
          <p class="step-desc">Structured industrial training across recognized hotels, resorts, and fine dining establishments in Nepal.</p>
        </div>

        <div class="placement-step">
          <div class="step-num">STAGE 04</div>
          <h3 class="step-title">Career Pathway & Beyond</h3>
          <p class="step-desc">Graduates build proven culinary resumes, paving the way for domestic executive roles and international hospitality transitions.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. ADMISSIONS & BATCH SCHEDULE CTA -->
  <section class="section section-white" id="admissions">
    <div class="container">
      <div class="admissions-box">
        <span class="eyebrow">Next Intake Enrollment</span>
        <h2 class="headline-lg">RESERVE YOUR KITCHEN STATION</h2>
        <p class="admissions-lead">
          To ensure every student receives direct access to commercial burners and knife coaching, DCA batches are capped at 16 students. Inquire now for current tuition fees, shift timings, and upcoming intake dates.
        </p>

        <div class="admissions-actions">
          <a 
            href={whatsappLink} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn btn-cib-solid btn-lg"
          >
            Chat with Admissions on WhatsApp
          </a>
          <button type="button" class="btn btn-cib-outline btn-lg" data-open-inquiry-modal data-preselect-course="Diploma in Culinary Arts (DCA)">
            Request Full Syllabus & Fees
          </button>
        </div>

        <div class="admissions-direct-call">
          <span>Direct Admissions Desk: </span>
          <a href={`tel:${SITE_DATA.institution.primaryPhone}`}>{SITE_DATA.institution.primaryPhone}</a> · 
          <a href={`tel:${SITE_DATA.institution.mobilePhone}`}>{SITE_DATA.institution.mobilePhone}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* =========================================================================
     1. BREADCRUMBS
     ========================================================================= */
  .breadcrumb-bar {
    background-color: var(--color-bg-warm);
    border-bottom: 1px solid var(--color-border);
    padding: 0.85rem 0;
  }

  .breadcrumbs {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .breadcrumbs a {
    color: var(--color-navy);
    transition: color var(--transition-fast);
  }

  .breadcrumbs a:hover {
    color: var(--color-orange);
  }

  .breadcrumbs .separator {
    color: var(--color-border-medium);
  }

  .breadcrumbs .active {
    color: var(--color-orange);
    font-weight: 700;
  }

  /* =========================================================================
     2. DCA ACADEMIC MASTHEAD
     ========================================================================= */
  .dca-masthead-section {
    position: relative;
    padding-top: clamp(2.5rem, 5vw, 4.25rem);
    padding-bottom: clamp(3rem, 5vw, 4.75rem);
    background-color: #FFFFFF;
    border-bottom: 1px solid var(--color-border);
  }

  .dca-masthead-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 4vw, 4.5rem);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .dca-masthead-grid {
      grid-template-columns: minmax(0, 1.14fr) minmax(0, 0.86fr);
    }
  }

  .dca-editorial-col,
  .dca-visual-col {
    min-width: 0;
    max-width: 100%;
  }

  /* Academic Taxonomy Badges */
  .dca-taxo-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .dca-code-badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-navy);
    background-color: var(--color-bg-warm);
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
  }

  .dca-type-badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-orange);
    background-color: rgba(224, 76, 28, 0.06);
    padding: 0.35rem 0.75rem;
    border: 1px solid rgba(224, 76, 28, 0.22);
    border-radius: var(--radius-xs);
  }

  .dca-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #166534;
    background-color: #f0fdf4;
    padding: 0.35rem 0.75rem;
    border: 1px solid #bbf7d0;
    border-radius: var(--radius-xs);
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #16a34a;
    display: inline-block;
  }

  /* Academic Headline */
  .dca-masthead-title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4.6vw, 4.15rem);
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--color-navy);
    margin-bottom: 1.5rem;
  }

  .text-orange {
    color: var(--color-orange);
  }

  /* Editorial Lead */
  .dca-masthead-lead {
    font-family: var(--font-serif);
    font-size: clamp(1.0625rem, 1.35vw, 1.25rem);
    line-height: 1.5;
    color: var(--color-navy);
    margin-bottom: 2.25rem;
    max-width: 58ch;
  }

  /* Actions */
  .dca-action-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 2.75rem;
  }

  @media (max-width: 640px) {
    .dca-action-strip {
      flex-direction: column;
      align-items: stretch;
      gap: 0.875rem;
      margin-bottom: 2rem;
    }

    .dca-primary-btn {
      width: 100%;
      justify-content: center;
    }

    .dca-visit-trigger {
      justify-content: center;
      padding: 0.5rem 0;
    }
  }

  .dca-primary-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .dca-visit-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    border: none;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--color-navy);
    cursor: pointer;
    padding: 0.5rem 0.25rem;
    transition: color var(--transition-fast);
  }

  .dca-visit-trigger:hover {
    color: var(--color-orange);
  }

  .dca-visit-trigger .arrow {
    transition: transform var(--transition-fast);
  }

  .dca-visit-trigger:hover .arrow {
    transform: translateX(4px);
  }

  /* Unboxed Integrated Fast Metrics */
  .dca-metrics-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 1.25rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 640px) {
    .dca-metrics-row {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  .dca-metric-cell {
    display: flex;
    flex-direction: column;
  }

  .dca-metric-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-orange);
    margin-bottom: 0.35rem;
  }

  .dca-metric-val {
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 2.75vw, 2.4rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-navy);
    margin-bottom: 0.25rem;
  }

  .dca-metric-unit {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-secondary);
    letter-spacing: normal;
  }

  .dca-metric-sub {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    line-height: 1.35;
  }

  /* Right Visual Cluster */
  .dca-media-cluster {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .dca-photo-wrapper {
    position: relative;
    border-radius: var(--radius-xs);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background-color: var(--color-bg-warm);
    box-shadow: var(--shadow-sm);
  }

  .dca-masthead-img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
  }

  .dca-photo-caption {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 1rem;
    background-color: #FFFFFF;
    border-top: 1px solid var(--color-border);
    font-size: 0.75rem;
  }

  .caption-tag {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    background-color: var(--color-navy);
    color: #FFFFFF;
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
    white-space: nowrap;
  }

  .caption-text {
    color: var(--color-text-secondary);
    white-space: normal;
    line-height: 1.35;
  }

  /* Architectural Course Specification Dossier */
  .dca-spec-dossier {
    background-color: var(--color-bg-warm);
    border: 1px solid var(--color-border-medium);
    border-radius: var(--radius-xs);
