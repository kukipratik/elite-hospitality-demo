<script>
  function initCourseFilters() {
    const tabs = document.querySelectorAll<HTMLButtonElement>(".filter-tab");
    const cards = document.querySelectorAll<HTMLElement>(".cib-course-card");
    if (!tabs.length || !cards.length) return;

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const filter = tab.getAttribute("data-filter");

        // Toggle tab styles
        tabs.forEach((t) => {
          t.classList.remove("is-active");
          t.setAttribute("aria-selected", "false");
        });
        tab.classList.add("is-active");
        tab.setAttribute("aria-selected", "true");

        // Toggle card visibility
        cards.forEach((card) => {
          const category = card.getAttribute("data-filter-category");
          if (filter === "all" || category === filter) {
            card.classList.remove("is-hidden");
          } else {
            card.classList.add("is-hidden");
          }
        });
      });
    });
  }

  // Run on mount
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCourseFilters);
  } else {
    initCourseFilters();
  }
</script>
