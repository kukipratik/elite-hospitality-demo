---
import BaseLayout from '../layouts/BaseLayout.astro';
import CourseCard from '../components/CourseCard.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import { SITE_DATA } from '../data/siteData';

const flagshipCourse = SITE_DATA.courses.find(c => c.isFlagship) || SITE_DATA.courses[0];
const otherCourses = SITE_DATA.courses.filter(c => !c.isFlagship);
const allCourses = SITE_DATA.courses;
---

<BaseLayout 
  title="Elite School of Hospitality Management | Kathmandu, Nepal"
  description="Kathmandu's premier culinary & hospitality academy at Pipalbot, Old Baneshwor. 60+ days nonstop commercial kitchen practicals, ten 4-course menus, dedicated Elite Bar, specialty barista studio, and structured hotel internships."
  currentPath="/"
>
  <!-- 1. HERO SECTION -->
  <section class="hero-section" id="hero">
    <div class="hero-bg-media">
      <img 
        src="/images/brand/cover.jpg" 
        alt="Elite School of Hospitality Management Commercial Kitchen" 
        class="hero-bg-img"
        fetchpriority="high"
        width="1920" 
        height="1080"
      />
      <div class="hero-bg-overlay"></div>
      <div class="hero-glow-copper"></div>
    </div>

    <div class="container hero-container">
      <div class="hero-content">
        <!-- Location & Accreditation Eyebrow -->
        <div class="hero-eyebrow fade-in">
          <span class="pulse-dot"></span>
          <span class="eyebrow-text">Pipalbot, Old Baneshwor · Kathmandu, Nepal</span>
        </div>

        <!-- Master Editorial Headline -->
        <h1 class="hero-title fade-in">
          Turn Your Passion <br />
          Into a <span class="font-serif italic text-copper">Professional Career</span>
        </h1>

        <!-- Subtitle -->
        <p class="hero-lead fade-in">
          Kathmandu’s dedicated culinary and hospitality academy. Master high-heat commercial cookery through 
          <strong>60+ days nonstop kitchen practicals</strong>, ten complete 4-course menus, neon-lit mixology, and 
          guaranteed 3–6 month hotel internships.
        </p>

        <!-- CTA Action Cluster -->
        <div class="hero-cta-group fade-in">
          <a href="/courses/dca" class="btn btn-primary btn-lg">
            <span>Explore Flagship DCA</span>
            <svg class="btn-arrow" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>

          <button type="button" class="btn btn-secondary btn-lg" data-open-modal="true" data-course-context="General Campus Inquiry">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>Book Campus Tour</span>
          </button>
        </div>

        <!-- Verified Live Proof Badges -->
        <div class="hero-proof-bar fade-in">
          <div class="proof-pill">
            <span class="proof-star">★</span>
            <span class="proof-val">4.7</span>
            <span class="proof-label">Google Rating (74 Reviews)</span>
          </div>
          <div class="proof-divider"></div>
          <div class="proof-pill">
            <span class="proof-val text-copper">60+ Days</span>
            <span class="proof-label">Nonstop Kitchen Practical</span>
          </div>
          <div class="proof-divider"></div>
          <div class="proof-pill">
            <span class="proof-val text-gold">100%</span>
            <span class="proof-label">Facebook Recommendation</span>
          </div>
        </div>
      </div>

      <!-- Hero Visual Accent Floating Card -->
      <div class="hero-visual-card fade-in">
        <div class="hero-card-inner">
          <div class="card-media-wrapper">
            <img 
              src="/images/kitchen/searing_chicken.jpg" 
              alt="Live Hot Kitchen Searing at Elite School of Hospitality" 
              class="card-img-main"
              width="600"
              height="450"
            />
            <div class="card-badge-floating">
              <span class="live-indicator"></span>
              <span>Commercial Hot Kitchen</span>
            </div>
          </div>
          <div class="card-caption-block">
            <div class="caption-header">
              <span class="caption-tag">DCA Practical Station</span>
              <span class="caption-meta">Batch 2026</span>
            </div>
            <h3 class="caption-heading">High-Heat Searing & Pan Basting</h3>
            <p class="caption-desc">Every student works live commercial burners with fresh ingredients, real protein cuts, and classical sauce reductions.</p>
            <div class="caption-footer">
              <a href="/courses/dca" class="card-link">View DCA Curriculum →</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. PROOF MARQUEE RIBBON -->
  <section class="proof-ribbon" aria-label="Verified highlights ticker">
    <div class="marquee-track">
      <div class="marquee-content">
        <span>★ 4.7 Google Business Rating (74 Reviews)</span>
        <span class="separator">✦</span>
        <span>60+ Days Nonstop Commercial Kitchen Practical</span>
        <span class="separator">✦</span>
        <span>Ten Complete 4-Course Menu Executions</span>
        <span class="separator">✦</span>
        <span>Dedicated "Elite Bar" Mixology Studio</span>
        <span class="separator">✦</span>
        <span>Specialty Barista Lab with Swan Art Pouring</span>
        <span class="separator">✦</span>
        <span>3 to 6 Months Hotel & Resort Internship Placement</span>
        <span class="separator">✦</span>
        <span>Pipalbot, Old Baneshwor, Kathmandu</span>
        <span class="separator">✦</span>
      </div>
      <!-- Duplicate for seamless CSS marquee scroll -->
      <div class="marquee-content" aria-hidden="true">
        <span>★ 4.7 Google Business Rating (74 Reviews)</span>
        <span class="separator">✦</span>
        <span>60+ Days Nonstop Commercial Kitchen Practical</span>
        <span class="separator">✦</span>
        <span>Ten Complete 4-Course Menu Executions</span>
        <span class="separator">✦</span>
        <span>Dedicated "Elite Bar" Mixology Studio</span>
        <span class="separator">✦</span>
        <span>Specialty Barista Lab with Swan Art Pouring</span>
        <span class="separator">✦</span>
        <span>3 to 6 Months Hotel & Resort Internship Placement</span>
        <span class="separator">✦</span>
        <span>Pipalbot, Old Baneshwor, Kathmandu</span>
        <span class="separator">✦</span>
      </div>
    </div>
  </section>

  <!-- 3. FLAGSHIP SPOTLIGHT: DIPLOMA IN CULINARY ARTS (DCA) -->
  <section class="section dca-spotlight-section" id="flagship-dca">
    <div class="container">
      <div class="spotlight-wrapper">
        <!-- Left Content -->
        <div class="spotlight-text-col fade-in">
          <div class="section-eyebrow">
            <span class="tag tag-copper">Flagship Qualification</span>
            <span class="text-muted">6 Months Intensive</span>
          </div>

          <h2 class="spotlight-title">
            Diploma in <br />
            <span class="font-serif italic text-copper">Culinary Arts (DCA)</span>
          </h2>

          <p class="spotlight-summary">
            A career-defining professional diploma designed to build confident, high-speed chefs ready for 
            five-star hotels, luxury resorts, and high-volume commercial kitchens in Nepal and overseas.
          </p>

          <div class="spotlight-specs-grid">
            <div class="spec-box">
              <span class="spec-number text-copper">60+</span>
              <span class="spec-label">Days Nonstop Practical</span>
              <p class="spec-sub">No filler lectures. Real daily cooking on commercial line stations.</p>
            </div>
            <div class="spec-box">
              <span class="spec-number text-gold">10</span>
              <span class="spec-label">Four-Course Menus</span>
              <p class="spec-sub">Complete full-course service execution from soup to dessert.</p>
            </div>
            <div class="spec-box">
              <span class="spec-number">16</span>
              <span class="spec-label">Seats Max Per Batch</span>
              <p class="spec-sub">Intimate batch size guarantees 1:1 supervision by senior chefs.</p>
            </div>
            <div class="spec-box">
              <span class="spec-number">3–6</span>
              <span class="spec-label">Months Internship</span>
              <p class="spec-sub">Structured placement in leading Nepal hotels, resorts & fine dining.</p>
            </div>
          </div>

          <div class="spotlight-highlights-list">
            <h4 class="highlights-heading">What You Will Master:</h4>
            <div class="highlights-grid">
              <div class="hl-item">
                <span class="hl-dot"></span>
                <span>Hot Kitchen Searing & Pan Cookery</span>
              </div>
              <div class="hl-item">
                <span class="hl-dot"></span>
                <span>Artisan Bakery & Laminated Pastries</span>
              </div>
              <div class="hl-item">
                <span class="hl-dot"></span>
                <span>Japanese Sushi & Asian Wok Art</span>
              </div>
              <div class="hl-item">
                <span class="hl-dot"></span>
                <span>Chocolate Tempering & Fruit Carving</span>
              </div>
              <div class="hl-item">
                <span class="hl-dot"></span>
                <span>Banquet & Outdoor Catering (ODC)</span>
              </div>
              <div class="hl-item">
                <span class="hl-dot"></span>
                <span>Commercial Kitchen Safety & HACCP</span>
              </div>
            </div>
          </div>

          <div class="spotlight-actions">
            <a href="/courses/dca" class="btn btn-primary btn-lg">
              <span>View Full DCA Syllabus & Modules</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>

            <button type="button" class="btn btn-secondary" data-open-modal="true" data-course-context="Diploma in Culinary Arts (DCA)">
              <span>Inquire on WhatsApp</span>
            </button>
          </div>
        </div>

        <!-- Right Visual Showcase -->
        <div class="spotlight-media-col fade-in">
          <div class="media-composition">
            <div class="media-frame-primary">
              <img 
                src="/images/kitchen/chef_technique.jpg" 
                alt="Elite School chef demonstrating pastry and culinary technique" 
                class="media-img-1"
                loading="lazy"
                width="700" 
                height="800"
              />
              <div class="frame-overlay"></div>
              <div class="experience-badge">
                <span class="badge-num">100%</span>
                <span class="badge-text">Hands-On Kitchen Line</span>
              </div>
            </div>

            <div class="media-frame-secondary">
              <img 
                src="/images/kitchen/cooking_demo.jpg" 
                alt="Elite School student practical cooking session" 
                class="media-img-2"
                loading="lazy"
                width="400" 
                height="300"
              />
              <div class="badge-accent">
                <span>Ten 4-Course Menus</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. INSIDE THE ACADEMY: VERIFIED VIDEO REEL STUDIO -->
  <section class="section reels-section" id="reels">
    <div class="container">
      <div class="section-head-editorial fade-in">
        <div class="section-badge-row">
          <span class="tag tag-copper">Real Academy Footage</span>
          <span class="text-muted">Filmed at Pipalbot Campus</span>
        </div>
        <h2 class="section-title">
          Inside Elite: <span class="font-serif italic text-copper">Watch Students at Work</span>
        </h2>
        <p class="section-subtitle">
          No staged actors or stock footage. These are real daily training sessions filmed inside our commercial kitchen and barista studio in Old Baneshwor.
        </p>
      </div>

      <div class="reels-grid">
        <!-- Reel 1: Culinary Technique -->
        <div class="reel-item fade-in">
          <VideoPlayer 
            id="reel-culinary"
            videoSrc="/video/elite_reel_1.mp4"
            posterSrc="/images/kitchen/searing_chicken.jpg"
            title="Student Chef Kitchen Technique"
            tag="Culinary Station"
            durationText="0:15"
          />
        </div>

        <!-- Reel 2: 4-Course Menu Tasting -->
        <div class="reel-item fade-in">
          <VideoPlayer 
            id="reel-menu"
            videoSrc="/video/elite_reel_2.mp4"
            posterSrc="/images/kitchen/cooking_demo.jpg"
            title="4-Course Meal Plating & Tasting"
            tag="DCA Plating Lab"
            durationText="0:30"
          />
        </div>

        <!-- Reel 3: Barista Extraction -->
        <div class="reel-item fade-in">
          <VideoPlayer 
            id="reel-barista"
            videoSrc="/video/elite_reel_3.mp4"
            posterSrc="/images/barista/espresso_machine.jpg"
            title="Specialty Barista & Swan Latte Art"
            tag="Barista Studio"
            durationText="0:45"
          />
        </div>
      </div>

      <div class="reels-footnote fade-in">
        <p>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
          Tap any video to play or unmute. Daily practical classes run in morning and afternoon batches.
        </p>
      </div>
    </div>
  </section>

  <!-- 5. PROGRAMS DISCOVERY (ALL COURSES) -->
  <section class="section courses-section" id="courses">
    <div class="container">
      <div class="courses-header-row fade-in">
        <div>
          <div class="section-badge-row">
            <span class="tag tag-gold">Complete Curriculum</span>
            <span class="text-muted">Affiliated & Industry Recognized</span>
          </div>
          <h2 class="section-title">
            Hospitality & Culinary <span class="font-serif italic text-gold">Programs</span>
          </h2>
          <p class="section-subtitle">
            From comprehensive 1-year management diplomas to intensive 1-month barista and flair mixology certifications.
          </p>
        </div>

        <!-- Filter Buttons -->
        <div class="filter-btn-group" id="courseFilterGroup">
          <button type="button" class="filter-btn active" data-filter="all">All Programs</button>
          <button type="button" class="filter-btn" data-filter="diploma">Diplomas</button>
          <button type="button" class="filter-btn" data-filter="certificate">Certificates</button>
          <button type="button" class="filter-btn" data-filter="specialization">Specializations</button>
        </div>
      </div>

      <!-- Course Cards Grid -->
      <div class="courses-grid" id="coursesGrid">
        {allCourses.map((course, idx) => (
          <div class="course-card-wrapper" data-category={course.category}>
            <CourseCard course={course} index={idx} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. THE 4 PRACTICAL PILLARS: WHY ELITE STANDS APART -->
  <section class="section pillars-section" id="methodology">
    <div class="container">
      <div class="section-head-editorial fade-in">
        <div class="section-badge-row">
          <span class="tag tag-copper">The Elite Advantage</span>
          <span class="text-muted">Vocational Immersion</span>
        </div>
        <h2 class="section-title">
          Built for the Kitchen Line, <br />
          <span class="font-serif italic text-copper">Not the Lecture Hall</span>
        </h2>
        <p class="section-subtitle">
          Traditional colleges spend months on theoretical textbooks. Elite puts you on active commercial workstations from day one.
        </p>
      </div>

      <div class="pillars-grid">
        <div class="pillar-card fade-in">
          <div class="pillar-icon-box">
            <span class="pillar-num">01</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <h3 class="pillar-title">60+ Days Nonstop Cooking</h3>
          <p class="pillar-desc">
            Continuous daily kitchen practicals. You master sautéing, high-heat searing, roasting, stocks, mother sauces, and precision knife work through sheer muscle memory.
          </p>
          <ul class="pillar-points">
            <li>Individual burner & station time</li>
            <li>Commercial chef knives & cookware</li>
            <li>Fresh daily ingredients provided</li>
          </ul>
        </div>

        <div class="pillar-card fade-in">
          <div class="pillar-icon-box">
            <span class="pillar-num">02</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polygon points="10 8 16 12 10 16 10 8"></polygon>
            </svg>
          </div>
          <h3 class="pillar-title">Ten 4-Course Menu Mastery</h3>
          <p class="pillar-desc">
            Cooking single dishes doesn't teach restaurant timing. Elite requires every DCA student to execute ten full 4-course banquet and restaurant services under realistic clock pressure.
          </p>
          <ul class="pillar-points">
            <li>Appetizers & crisp salad compositions</li>
            <li>Classical soups & reduction broths</li>
            <li>Entrées, poultry, seafood & glazes</li>
          </ul>
        </div>

        <div class="pillar-card fade-in">
          <div class="pillar-icon-box">
            <span class="pillar-num">03</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"></path>
            </svg>
          </div>
          <h3 class="pillar-title">Dedicated Bar & Barista Studios</h3>
          <p class="pillar-desc">
            Step behind our real neon-lit "Elite Bar" counter for mixology, jigger accuracy, and bottle flair. Train on commercial dual-boiler espresso machines for swan latte art.
          </p>
          <ul class="pillar-points">
            <li>Real bar layout with cocktail glasses</li>
            <li>Commercial grinder & espresso calibration</li>
            <li>Sensory cupping & milk texture microfoam</li>
          </ul>
        </div>

        <div class="pillar-card fade-in">
          <div class="pillar-icon-box">
            <span class="pillar-num">04</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
            </svg>
          </div>
          <h3 class="pillar-title">3–6 Mo Internship & ODC</h3>
          <p class="pillar-desc">
            Graduate with verified industry experience. Elite coordinates 3 to 6-month internships at premier Nepal hotels and resorts, alongside hands-on Outdoor Catering (ODC) certifications.
          </p>
          <ul class="pillar-points">
            <li>Hotel, resort & fine dining placements</li>
            <li>Grand banquet & event catering exposure</li>
            <li>Strong foundation for Gulf & Europe pathways</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. ACADEMIC & INSTITUTIONAL PARTICIPATION PROOF -->
  <section class="section collab-section">
    <div class="container">
      <div class="collab-box fade-in">
        <div class="collab-header">
          <span class="tag tag-gold">Institutional Sessions</span>
          <h3 class="collab-heading">Trusted by Kathmandu Colleges for Hands-On Workshops</h3>
          <p class="collab-text">
            Elite has welcomed visiting hospitality students from prestigious Kathmandu institutions for intensive practical culinary and beverage workshops.
          </p>
        </div>

        <div class="collab-grid">
          {SITE_DATA.collaborativeProof.map((collab) => (
            <div class="collab-card">
              <div class="collab-badge">Host & Practical Trainer</div>
              <h4 class="collab-name">{collab.name}</h4>
              <p class="collab-context">{collab.context}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 8. VERIFIED GOOGLE & COMMUNITY REVIEWS -->
  <section class="section reviews-section" id="reviews">
    <div class="container">
      <div class="section-head-editorial fade-in">
        <div class="section-badge-row">
          <span class="tag tag-copper">Verified Feedback</span>
          <span class="text-muted">4.7★ on Google Business</span>
        </div>
        <h2 class="section-title">
          What Our Students <span class="font-serif italic text-copper">& Alumni Say</span>
        </h2>
        <p class="section-subtitle">
          Authentic student and community feedback from our Google Business Profile and official social channels.
        </p>
      </div>

      <div class="reviews-grid">
        {SITE_DATA.reviews.map((rev) => (
          <article class="review-card fade-in">
            <div class="review-stars-row">
              {Array.from({ length: rev.rating }).map(() => (
                <span class="star-icon">★</span>
              ))}
              <span class="review-badge-tag">{rev.badge}</span>
            </div>

            <p class="review-quote">“{rev.reviewText}”</p>

            <div class="review-author-block">
              <div class="author-avatar-initial">
                {rev.author.charAt(0)}
              </div>
              <div class="author-meta">
                <h4 class="author-name">{rev.author}</h4>
                <span class="author-source">{rev.dateText}</span>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Google Business Banner -->
      <div class="google-proof-banner fade-in">
        <div class="google-badge-left">
          <svg class="google-icon" viewBox="0 0 24 24" width="24" height="24" xmlns="http://www.w3.org/2000/svg">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
          </svg>
          <div>
            <strong>4.7 Out of 5.0 Stars</strong>
            <span class="text-muted">· Based on 74 verified Google Reviews</span>
          </div>
        </div>
        <a 
          href={SITE_DATA.institution.googleMapsUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-secondary btn-sm"
        >
          <span>View on Google Maps →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 9. CAMPUS LOCATION & VISIT SCHEDULER -->
  <section class="section location-section" id="location">
    <div class="container">
      <div class="location-wrapper">
        <div class="location-info-col fade-in">
          <div class="section-badge-row">
